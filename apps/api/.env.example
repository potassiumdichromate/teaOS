# Copy to .env and fill in real values. Never commit .env (it's gitignored).
# See docs/DEPLOYMENT.md and docs/MAINNET_DEPLOYMENT.md for what each of
# these is for and where to get it. Nothing in this project falls back to a
# mock when a credential is missing — apps/api/src/config/env.ts fails fast
# and loudly instead (see knowledge_base.md §12).

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nvei"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-a-real-random-secret-at-least-16-chars"
JWT_EXPIRES_IN="12h"

# 32-byte hex string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUESTION_BANK_MASTER_KEY=""

# Salts the (applicationId, dob) -> ResultRegistry lookup key. Any random string, at least 16 chars.
RESULT_KEY_SALT=""

# testnet = Galileo (chain 16602, free), mainnet = Aristotle (chain 16661, real gas)
ZG_NETWORK="testnet"
ZG_RPC_URL="https://evmrpc-testnet.0g.ai"
ZG_CHAIN_ID="16602"
# EVM private key for a funded 0G wallet — signs storage uploads and every registry anchor tx.
ZG_SERVICE_PRIVATE_KEY=""

# Filled in after `npm run contracts:deploy:testnet` (or :mainnet) — see docs/SMART_CONTRACTS.md
QUESTION_REGISTRY_ADDRESS=""
PAPER_REGISTRY_ADDRESS=""
SUBMISSION_REGISTRY_ADDRESS=""
RESULT_REGISTRY_ADDRESS=""
AUDIT_LOG_REGISTRY_ADDRESS=""

ZG_STORAGE_INDEXER_URL="https://indexer-storage-testnet-turbo.0g.ai"

ZG_COMPUTE_ROUTER_URL="https://router-api-testnet.integratenetwork.work/v1"
# Create at pc.0g.ai -> Dashboard -> API Keys, with `inference` permission.
ZG_COMPUTE_API_KEY=""
ZG_COMPUTE_MODEL="glm-5.2"
ZG_COMPUTE_TRUST_MODE="private"

# drand/tlock timelock backend (replaced Miden P2IDE 2026-07-28, see knowledge_base.md §11o-§11p)
TLOCK_NETWORK="mainnet"

# Miden bridge kept dormant, not deleted — only the (unused) submission-note path still references it.
MIDEN_NETWORK="testnet"
MIDEN_BRIDGE_URL="http://localhost:8787"
MIDEN_SERVICE_KEYSTORE_PATH="./contracts/miden/keys"

API_PORT="4000"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
