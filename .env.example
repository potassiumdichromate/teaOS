# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nvei"
REDIS_URL="redis://localhost:6379"

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# 32-byte hex key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Question-bank content keys are derived from this (see apps/api/src/lib/crypto.ts).
# Rotating it makes every previously-accepted question's stored blob unreadable — treat
# it like a database credential, not an app config value.
QUESTION_BANK_MASTER_KEY=""

# Salts the (applicationId, dob) -> ResultRegistry lookup key. See the
# tradeoff note in apps/api/src/config/env.ts: this means /verify is the only
# way to recompute a result's on-chain key, not fully independent third-party
# recomputation from applicationId+DOB alone.
RESULT_KEY_SALT=""

# ── 0G network selector: "testnet" | "mainnet" ─────────────────────────
ZG_NETWORK="mainnet"

# ── 0G Chain (EVM) ──────────────────────────────────────────────────────
# testnet (Galileo, chainId 16602): https://evmrpc-testnet.0g.ai
# mainnet (Aristotle, chainId 16661): https://evmrpc.0g.ai
ZG_RPC_URL="https://evmrpc-testnet.0g.ai"
ZG_CHAIN_ID="16602"
# NEVER put a real private key in this file — .env.example is a template
# meant to be safe to commit. Real keys go in apps/api/.env (gitignored) only.
ZG_SERVICE_PRIVATE_KEY=""

# Registry contract addresses (populated after `npm run contracts:deploy:testnet`)
QUESTION_REGISTRY_ADDRESS=""
PAPER_REGISTRY_ADDRESS=""
SUBMISSION_REGISTRY_ADDRESS=""
RESULT_REGISTRY_ADDRESS=""
AUDIT_LOG_REGISTRY_ADDRESS=""

# ── 0G Storage ──────────────────────────────────────────────────────────
# testnet: https://indexer-storage-testnet-turbo.0g.ai
# mainnet: https://indexer-storage-turbo.0g.ai
ZG_STORAGE_INDEXER_URL="https://indexer-storage-testnet-turbo.0g.ai"

# ── 0G Compute (Router API) ─────────────────────────────────────────────
# testnet: https://router-api-testnet.integratenetwork.work/v1
# mainnet: https://router-api.0g.ai/v1
ZG_COMPUTE_ROUTER_URL="https://router-api-testnet.integratenetwork.work/v1"
# NEVER put a real API key in this file either — same reasoning as above.
ZG_COMPUTE_API_KEY=""
ZG_COMPUTE_MODEL="glm-5.2"
ZG_COMPUTE_TRUST_MODE="private"

# ── Paper key-release timelock (drand/tlock, see knowledge_base.md §11o) ─
TLOCK_NETWORK="mainnet"

# ── Miden (testnet only — no Miden mainnet exists; kept dormant, only the
#    submission-commitment note path still targets this bridge) ────────
MIDEN_NETWORK="testnet"
MIDEN_BRIDGE_URL="http://localhost:50151"
MIDEN_SERVICE_KEYSTORE_PATH="./contracts/miden/keys"

# ── App ─────────────────────────────────────────────────────────────────
API_PORT="4000"
WEB_PORT="5173"
CORS_ORIGIN="http://localhost:5173"
