{
  "name": "nvei",
  "private": true,
  "version": "0.1.0",
  "description": "National Verifiable Examination Infrastructure",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts/evm"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "contracts:compile": "npm run compile -w contracts/evm",
    "contracts:deploy:testnet": "npm run deploy:testnet -w contracts/evm",
    "contracts:deploy:mainnet": "npm run deploy:mainnet -w contracts/evm"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
